PORT=3000
CORS_ORIGIN=http://localhost:4200

# Postgres
DATABASE_URL=postgres://fueld:fueld@localhost:5432/fueld

# JWT Secrets (replace in production with strong random values)
JWT_ACCESS_SECRET=fueld-access-secret-change-me
JWT_REFRESH_SECRET=fueld-refresh-secret-change-me

# Encrypts integration credentials at rest (SMTP, Microsoft 365, Kantox, LLM,
# banking, push keys). REQUIRED — the app refuses to start without it.
# Generate: openssl rand -hex 32
# Losing this key makes every stored credential unrecoverable; back it up in
# your password manager, and restore it alongside any database restore.
CREDENTIALS_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# Local LLM (llama-server) — managed from /admin/llm
# LLM_BASE_URL=http://127.0.0.1:8081
# LLM_TIMEOUT=30000
# LLM_SCRIPT_DIR=../../scripts/llm
# MAX_MODEL_SIZE_MB=4096

# SearXNG (self-hosted web search for LLM)
# SEARXNG_URL=http://127.0.0.1:8888

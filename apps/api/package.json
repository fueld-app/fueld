{
  "name": "@fueld/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/swagger": "^1.2.0",
    "@fueld/types": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.2.0",
    "jose": "^6.1.3",
    "otpauth": "^9.5.0",
    "pdfmake": "^0.3.3",
    "postgres": "^3.4.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pdfmake": "^0.3.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.7.0"
  }
}

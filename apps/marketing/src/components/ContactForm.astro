---
import { regionOptions, siteConfig } from '../config/site';

interface Props {
  id?: string;
}

const { id = 'contact' } = Astro.props;
---

<section id={id} class="contact-shell" aria-labelledby="contact-title">
  <div class="contact-copy">
    <p class="eyebrow">Book an intro call</p>
    <h2 id="contact-title">Tell us how you want to run Fueld.</h2>
    <p>
      Use the form to request an intro meeting. We will follow up on your preferred operating
      model, hosting region, and the workflows you want to improve first.
    </p>
    <ul class="contact-points" role="list">
      <li>Dedicated deployment, not a shared tenant pool.</li>
      <li>Self-hosted, customer-managed, or Fueld-managed infrastructure.</li>
      <li>Mobile-ready workflows for traders, operators, and management.</li>
    </ul>
    <p class="contact-fallback">
      Prefer email? Write to <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.
    </p>
    <p class="contact-fallback">Shoreline 13, Palm Jumeirah, Dubai, UAE.</p>
  </div>

  <form
    class="contact-form"
    id="contact-form"
    name="marketing-contact"
    method="POST"
    action="/thanks/"
    data-netlify="true"
    netlify-honeypot="company-website"
    novalidate
    data-contact-email="sales@fueld.app"
  >
    <input type="hidden" name="form-name" value="marketing-contact" />
    <p class="sr-only">
      <label>
        Leave this field empty if you are human
        <input name="company-website" autocomplete="off" tabindex="-1" />
      </label>
    </p>

    <div class="form-error-banner" id="contact-error-banner" role="alert" hidden></div>
    <p class="sr-only">
      <label>
        Leave this field empty if you are human
        <input name="company-website" autocomplete="off" tabindex="-1" />
      </label>
    </p>

    <div class="field-grid two-up">
      <label>
        <span>Name</span>
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label>
        <span>Work email</span>
        <input name="email" type="email" autocomplete="email" required />
      </label>
    </div>

    <div class="field-grid two-up">
      <label>
        <span>Company</span>
        <input name="company" type="text" autocomplete="organization" required />
      </label>
      <label>
        <span>Role</span>
        <input name="role" type="text" autocomplete="organization-title" placeholder="Broker, trader, ops, finance..." required />
      </label>
    </div>

    <div class="field-grid two-up">
      <label>
        <span>Deployment preference</span>
        <select name="deploymentPreference" required>
          <option value="">Select an option</option>
          <option>Self-hosted or on premises</option>
          <option>Managed by our team on dedicated infrastructure</option>
          <option>We are deciding</option>
        </select>
      </label>
      <label>
        <span>Preferred hosting region</span>
        <select name="preferredRegion" required>
          <option value="">Select a region</option>
          {regionOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
      </label>
    </div>

    <label>
      <span>What needs to improve first?</span>
      <textarea
        name="message"
        rows="5"
        required
        placeholder="Examples: faster RFQ handling, document automation, credit controls, supplier communication, mobile usability..."
      ></textarea>
    </label>

    <button type="submit" id="contact-submit">
      <span class="btn-label">Request a meeting</span>
      <span class="btn-spinner" aria-hidden="true"></span>
    </button>
  </form>
</section>

<script>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    var banner = document.getElementById('contact-error-banner');
    var submitBtn = document.getElementById('contact-submit');
    var label = submitBtn.querySelector('.btn-label');
    var btnLabel = label.textContent;

    function setError(input, message) {
      input.setAttribute('aria-invalid', 'true');
      var existing = input.closest('label').querySelector('.field-error');
      if (!existing) {
        existing = document.createElement('span');
        existing.className = 'field-error';
        input.closest('label').appendChild(existing);
      }
      existing.textContent = message;
    }

    function clearError(input) {
      input.removeAttribute('aria-invalid');
      var e = input.closest('label') && input.closest('label').querySelector('.field-error');
      if (e) e.remove();
    }

    form.querySelectorAll('input, select, textarea').forEach(function (el) {
      el.addEventListener('input', function () { clearError(el); });
      el.addEventListener('change', function () { clearError(el); });
    });

    function validate() {
      var bad = [];
      form.querySelectorAll('[required]').forEach(function (el) {
        var v = (el.value || '').trim();
        if (!v) {
          setError(el, 'This field is required.');
          bad.push(el);
        } else if (el.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) {
          setError(el, 'Enter a valid work email.');
          bad.push(el);
        }
      });
      if (bad.length) {
        bad[0].focus();
        banner.hidden = false;
        banner.textContent = 'Please fix the highlighted fields below.';
        return false;
      }
      return true;
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      banner.hidden = true;
      if (!validate()) return;

      setBusy(true);
      var body = new URLSearchParams(new FormData(form)).toString();
      fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body,
      })
        .then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          window.location.href = '/thanks/';
        })
        .catch(function () {
          setBusy(false);
          banner.hidden = false;
          banner.textContent = 'Something went wrong sending the form. Please email ' + form.dataset.contactEmail + ' instead.';
        });
    });

    function setBusy(busy) {
      submitBtn.disabled = busy;
      submitBtn.classList.toggle('is-busy', busy);
      label.textContent = busy ? 'Sending…' : btnLabel;
      submitBtn.setAttribute('aria-busy', String(busy));
    }
  })();
</script>
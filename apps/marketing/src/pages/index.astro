<script>
  document.documentElement.classList.add('has-js');
  // ── Margin simulator ──────────────────────────────────────────────────
  const fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
  const idx = document.getElementById('sim-index') as HTMLInputElement | null;
  const diff = document.getElementById('sim-diff') as HTMLInputElement | null;
  const prem = document.getElementById('sim-premium') as HTMLInputElement | null;
  const costEl = document.getElementById('sim-cost');

  function render() {
    if (!idx || !diff || !prem) return;
    const i = parseFloat(idx.value), d = parseFloat(diff.value), p = parseFloat(prem.value);
    const price = i + d + p;
    const cost = i * 0.923 + 5; // plausible cost model for the demo
    const margin = price - cost;
    document.getElementById('sim-index-out')!.textContent = fmt.format(i);
    document.getElementById('sim-diff-out')!.textContent = (d >= 0 ? '+$' : '-$') + Math.abs(d).toFixed(2);
    document.getElementById('sim-premium-out')!.textContent = fmt.format(p);
    document.getElementById('sim-price')!.textContent = fmt.format(price);
    if (costEl) costEl.textContent = fmt.format(cost);
    document.getElementById('sim-margin')!.textContent = `${fmt.format(margin)} / mt`;
  }
  [idx, diff, prem].forEach((el) => el?.addEventListener('input', render));
  render();

  // ── Reveal on scroll ──────────────────────────────────────────────
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('in-view')),
      { threshold: 0.12 }
    );
    document.querySelectorAll('.dk-manifest__row, .dk-roles, .dk-node, .dk-sim, .dk-featured, .dk-palette').forEach((el) => {
      el.classList.add('dk-reveal');
      io.observe(el);
    });
  }
</script>
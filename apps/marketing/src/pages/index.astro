---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { siteConfig } from '../config/site';

// ─── Roles ────────────────────────────────────────────────────────────
const roles = [
  {
    name: 'Broker',
    code: 'BRK',
    body:
      'Move from RFQ to confirmation without re-typing. Capture inquiries, compare quotes, and track negotiations in one thread. Client history and margin always in view.',
    day: ['08:12', 'RFQ lands from the vessel', '08:19', '3 quotes out to suppliers', '11:40', 'Confirmation signed & sent'],
  },
  {
    name: 'Trader',
    code: 'TRD',
    body:
      'Find suppliers anywhere in the world in seconds, execute with live market context, enforce credit at confirmation, and watch positions and margin update in real time — with an audit-ready trail.',
    day: ['09:02', 'Exposure checked across 4 ports', '09:15', 'Credit hold cleared on RTM stem', '15:30', 'Margin locked to the deal'],
  },
  {
    name: 'Physical Supplier',
    code: 'SUP',
    body:
      'Plan barges, trucks, and slots against live inventory. Match stock to liftings, capture quotes through the supplier portal, and keep dispatch, BDN, and reconciliation in one place from nomination to sign-off.',
    day: ['06:45', 'Barge slots planned against dips', '12:10', 'Nomination confirmed', '17:55', 'BDN reconciled to the system'],
  },
];

// ─── Pipeline ─────────────────────────────────────────────────────────
const pipeline = [
  { code: 'RFQ-2417', label: 'Inquiry in', body: 'Vessel, port, grades, quantities — captured once, parsed from email or entered in seconds.', status: 'Received', tone: 'cyan' },
  { code: 'QTE-0931', label: 'Quotes compared', body: 'Supplier offers land side by side with margin, history, and responsiveness ranked.', status: '3 offers', tone: 'cyan' },
  { code: 'CNF-0988', label: 'Confirmed', body: 'Credit checked at confirmation, formula locked, PDF out from your own templates.', status: 'Signed', tone: 'amber' },
  { code: 'BDN-5512', label: 'Delivered', body: 'Barge dispatched, BDN generated and sent, volumes reconciled to the system.', status: 'Closed', tone: 'emerald' },
];

// ─── Manifest features ────────────────────────────────────────────────
const manifest = [
  {
    index: '01',
    title: 'Pricing engine & margin builder',
    body: 'Build prices from index + differential + premiums, simulate the margin live, and lock the formula onto the confirmation. The desk sees the same math the trade sees.',
  },
  {
    index: '02',
    title: 'Supplier portal & inquiry intelligence',
    body: 'Suppliers quote, confirm, and file BDNs through a self-service portal — while the system scores responsiveness, win rate, and pricing behaviour from your own history.',
  },
  {
    index: '03',
    title: 'Credit at the point of confirmation',
    body: 'Limits, exposure, holds, and approval routing sit on the deal screen — not in a spreadsheet someone updates on Fridays.',
  },
  {
    index: '04',
    title: 'Documents with a memory',
    body: 'Confirmations, nominations, BDNs, and invoices — every revision tracked, diffed, and attributed to who changed what, when.',
  },
  {
    index: '05',
    title: 'Inventory to stem plan',
    body: 'Track product, grade, and volume across tanks, barges, and terminals — reconciled to dips and liftings, ready for dispatch.',
  },
];

const alsoInBox = [
  'Global supplier directory',
  'Approach playbooks',
  'Risk & compliance screening',
  'Multi-currency & live FX',
  'Vessel & fleet database (IMO-keyed)',
  'WhatsApp for Business',
  'Outlook & Exchange threading',
  'Push notifications (iOS / Android / desktop)',
  'Platts & Argus price feeds',
  'QuickBooks & accounting sync',
  'Configurable fields, templates & approvals',
  'Audit-ready trails on everything',
];

// ─── Integrations marquee ─────────────────────────────────────────────
const marqueeA = ['Microsoft 365 SSO', 'Outlook & Exchange', 'WhatsApp Business', 'Passkeys & 2FA', 'Live AIS vessel data', 'QuickBooks', 'Platts & Argus feeds', 'Push notifications'];
const marqueeB = ['Entra ID / Azure AD', 'BDN generation', 'Credit engines', 'Formula pricing', 'Inventory & dips', 'Audit trails', 'Document versioning', 'Supplier portal'];

// ─── Sovereignty ──────────────────────────────────────────────────────
const sovereigntyPoints = [
  'Dedicated deployment — never a pooled SaaS tenant database.',
  'Self-hosted, on-premises, or dedicated managed infrastructure.',
  'Regional hosting aligned to your policy: EU, UK, US, UAE, Singapore.',
  'No shared training loop across customer data. License validation only.',
];

// ─── FAQ (trimmed) ────────────────────────────────────────────────────
const faqs = [
  {
    question: 'How fast can we be live?',
    answer:
      'Self-hosted deployments install in roughly a day with the provided installer. A typical managed go-live with data migration, SSO, document templates, and team training runs four to eight weeks depending on scope.',
  },
  {
    question: 'Is this a shared multi-tenant SaaS platform?',
    answer:
      'No. The commercial model is dedicated deployment. Your environment and your data are not mixed into a shared customer pool — on your hardware or ours.',
  },
  {
    question: 'How is Fueld priced?',
    answer:
      'Annual license per active user with a deployment fee. Modules are à la carte — only pay for what you turn on. Concrete numbers are shared on the demo call.',
  },
];

const customers = ['Riviera Marine', 'Moxie', 'ChannelTX'];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.siteUrl,
    email: siteConfig.contactEmail,
    description: siteConfig.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Fueld',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description:
      'Dedicated bunker trading software with data sovereignty, regional hosting control, and mobile-ready workflows.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      description: 'Commercial pricing is provided during a sales conversation.',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout
  title="Bunker trading & physical supply software"
  description="One platform for bunker brokers, traders, and physical suppliers. RFQ to barge dispatch to BDN, with passkeys, Microsoft 365 SSO, Outlook, WhatsApp, live AIS, QuickBooks, and a built-in private LLM. Dedicated deployment, never a shared SaaS pool."
  path="/"
  schemas={schemas}
>
  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <section class="dk-hero">
    <div class="dk-hero__plot" aria-hidden="true">
      <svg viewBox="0 0 1200 640" preserveAspectRatio="xMidYMid slice" fill="none">
        <!-- graticule -->
        <g class="dk-plot-grid">
          <path d="M0 80 H1200 M0 160 H1200 M0 240 H1200 M0 320 H1200 M0 400 H1200 M0 480 H1200 M0 560 H1200" />
          <path d="M100 0 V640 M200 0 V640 M300 0 V640 M400 0 V640 M500 0 V640 M600 0 V640 M700 0 V640 M800 0 V640 M900 0 V640 M1000 0 V640 M1100 0 V640" />
        </g>
        <!-- vessel tracks -->
        <g class="dk-plot-track">
          <path d="M-20 520 C 180 470, 260 300, 430 260 S 760 180, 930 210 S 1150 150, 1230 120" style="--dur: 26s; --delay: 0s" />
          <path d="M-20 120 C 200 160, 340 260, 540 300 S 900 380, 1230 340" style="--dur: 32s; --delay: -8s" />
          <path d="M-20 340 C 240 380, 420 480, 640 440 S 980 300, 1230 260" style="--dur: 38s; --delay: -16s" />
        </g>
        <!-- port nodes -->
        <g class="dk-plot-ports">
          <g style="--delay: 0s"><circle cx="430" cy="300" r="4" /><text x="446" y="294">NLRTM</text></g>
          <g style="--delay: 1.4s"><circle cx="930" cy="212" r="4" /><text x="946" y="206">SGSIN</text></g>
          <g style="--delay: 2.6s"><circle cx="640" cy="440" r="4" /><text x="656" y="434">AEJEA</text></g>
          <g style="--delay: 3.8s"><circle cx="200" cy="160" r="4" /><text x="216" y="154">USHOU</text></g>
        </g>
      </svg>
    </div>

    <div class="dk-hero__inner">
      <div class="dk-hero__copy">
        <p class="eyebrow">Bunker trading · Physical supply · One system</p>
        <h1 class="dk-hero__title">
          Every stem,<br /><span class="dk-amber">on one screen.</span>
        </h1>
        <p class="dk-hero__lead">
          Fueld runs the deal from RFQ to barge dispatch to BDN — quotes, credit,
          documents, delivery — on infrastructure you control. Not a shared SaaS pool.
        </p>
        <div class="cta-row">
          <a class="button button-primary" href="#contact">Book a demo →</a>
          <a class="button button-secondary" href="#pipeline">See it work</a>
        </div>
        <ul class="dk-portclock" role="list" aria-label="Port clocks">
          <li><span class="dk-portclock__dot" aria-hidden="true"></span>SGSIN <strong>14:32</strong></li>
          <li><span class="dk-portclock__dot" aria-hidden="true"></span>NLRTM <strong>08:32</strong></li>
          <li><span class="dk-portclock__dot" aria-hidden="true"></span>AEJEA <strong>10:32</strong></li>
          <li><span class="dk-portclock__dot" aria-hidden="true"></span>USHOU <strong>02:32</strong></li>
        </ul>
      </div>

      <div class="dk-hero__stage" aria-hidden="true">
        <div class="dk-appframe">
          <img src="/img/app-deck.png" alt="" width="1432" height="640" loading="eager" />
          <div class="dk-appframe__glow"></div>
        </div>
        <div class="dk-floatchip dk-floatchip--a">
          <span class="dk-floatchip__label">Live exposure</span>
          <span class="dk-floatchip__value">$2.4M</span>
          <span class="dk-floatchip__delta dk-floatchip__delta--up">▲ 12% wk</span>
        </div>
        <div class="dk-floatchip dk-floatchip--b">
          <span class="dk-floatchip__label">Open stems</span>
          <span class="dk-floatchip__value">38</span>
          <span class="dk-floatchip__delta dk-floatchip__delta--up">▲ 6 today</span>
        </div>
      </div>
    </div>

    <!-- Live deal ticker -->
    <div class="dk-ticker" aria-hidden="true">
      <div class="dk-ticker__inner">
        <!-- ROW 1 -->
        <div class="dk-tick" style="--tick-delay: 0s">
          <span class="dk-tick__port">NLRTM</span>
          <span class="dk-tick__product">VLSFO 0.5%</span>
          <span class="dk-tick__value">
            <span class="dk-tick__a">$573.50</span>
            <span class="dk-tick__b">$574.25</span>
          </span>
          <span class="dk-tick__delta">
            <span class="dk-tick__a dk-up">▲ 2.1</span>
            <span class="dk-tick__b dk-up">▲ 2.4</span>
          </span>
        </div>
        <!-- ROW 2 -->
        <div class="dk-tick" style="--tick-delay: -1.8s">
          <span class="dk-tick__port">SGSIN</span>
          <span class="dk-tick__product">MGO</span>
          <span class="dk-tick__value">
            <span class="dk-tick__a">$612.00</span>
            <span class="dk-tick__b">$611.25</span>
          </span>
          <span class="dk-tick__delta">
            <span class="dk-tick__a dk-down">▼ 0.4</span>
            <span class="dk-tick__b dk-down">▼ 0.7</span>
          </span>
        </div>
        <!-- ROW 3 -->
        <div class="dk-tick" style="--tick-delay: -3.1s">
          <span class="dk-tick__port">AEJEA</span>
          <span class="dk-tick__product">VLSFO</span>
          <span class="dk-tick__value">
            <span class="dk-tick__a">$581.75</span>
            <span class="dk-tick__b">$582.50</span>
          </span>
          <span class="dk-tick__delta">
            <span class="dk-tick__a dk-up">▲ 1.2</span>
            <span class="dk-tick__b dk-up">▲ 1.5</span>
          </span>
        </div>
        <!-- ROW 4 -->
        <div class="dk-tick" style="--tick-delay: -4.4s">
          <span class="dk-tick__port">USHOU</span>
          <span class="dk-tick__product">HSFO 380</span>
          <span class="dk-tick__value">
            <span class="dk-tick__a">$438.00</span>
            <span class="dk-tick__b">$437.25</span>
          </span>
          <span class="dk-tick__delta">
            <span class="dk-tick__a dk-down">▼ 1.8</span>
            <span class="dk-tick__b dk-down">▼ 1.4</span>
          </span>
        </div>
        <!-- ROW 5 -->
        <div class="dk-tick" style="--tick-delay: -2.4s">
          <span class="dk-tick__port">HKHK</span>
          <span class="dk-tick__product">VLSFO 0.5%</span>
          <span class="dk-tick__value">
            <span class="dk-tick__a">$588.50</span>
            <span class="dk-tick__b">$588.00</span>
          </span>
          <span class="dk-tick__delta">
            <span class="dk-tick__a dk-up">▲ 0.6</span>
            <span class="dk-tick__b dk-up">▲ 0.9</span>
          </span>
        </div>
        <!-- ROW 6 -->
        <div class="dk-tick" style="--tick-delay: -5.2s">
          <span class="dk-tick__port">NLRTM</span>
          <span class="dk-tick__product">Brent</span>
          <span class="dk-tick__value">
            <span class="dk-tick__a">$98.38</span>
            <span class="dk-tick__b">$98.61</span>
          </span>
          <span class="dk-tick__delta">
            <span class="dk-tick__a dk-up">▲ 2.2</span>
            <span class="dk-tick__b dk-up">▲ 2.5</span>
          </span>
        </div>
      </div>
      <div class="dk-ticker__scan"></div>
    </div>
  </section>

  <!-- ═══════════════════════ CUSTOMERS / PROOF ═══════════════════ -->
  <section class="content-band content-band--thin dk-proof" aria-label="Customers and platform facts">
    <p class="dk-proof__label">Running desks at</p>
    <ul class="dk-proof__customers" role="list">
      {customers.map((c) => <li>{c}</li>)}
    </ul>
    <ul class="dk-proof__stats" role="list">
      <li><strong>&lt; 200 ms</strong><span>median API response</span></li>
      <li><strong>99.9%</strong><span>uptime SLO on managed</span></li>
      <li><strong>1 day</strong><span>self-host install</span></li>
      <li><strong>EU · UK · US · UAE · SG</strong><span>hosting regions</span></li>
    </ul>
  </section>

  <!-- ═══════════════════════════ ROLES ══════════════════════════ -->
  <section class="content-band" id="roles" aria-labelledby="roles-title">
    <div class="section-heading">
      <p class="eyebrow">Roles</p>
      <h2 id="roles-title">Trading desk and physical supply, in one product.</h2>
      <p>
        Purpose-built for the marine fuel chain — brokers, traders, and physical suppliers operating
        barges, trucks, and terminals. Same product, role-aware workflows, no bolt-on ERP.
      </p>
    </div>
    <div class="dk-roles">
      {roles.map((role) => (
        <article class="dk-role">
          <header class="dk-roles__head">
            <span class="dk-roles__code">{role.code}</span>
            <h3>{role.name}</h3>
          </header>
          <p class="dk-roles__body">{role.body}</p>
          <footer class="dk-roles__day" aria-label="A morning with this role">
            {role.day.map((line, i) => (i % 2 === 0
              ? <span class="dk-roles__day-time">{line}</span>
              : <span class="dk-roles__day-line">{line}</span>
            ))}
          </footer>
        </article>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════ PIPELINE ═══════════════════════ -->
  <section class="content-band" id="pipeline" aria-labelledby="pipeline-title">
    <div class="section-heading">
      <p class="eyebrow">How a deal moves</p>
      <h2 id="pipeline-title">RFQ to BDN without the spreadsheet between.</h2>
      <p>
        The whole value is the pipeline — so here is the pipeline. One thread from first
        inquiry to signed BDN, with credit, documents, and dispatch riding on the same record.
      </p>
    </div>
    <div class="dk-pipeline">
      <svg class="dk-pipeline__wire" viewBox="0 0 1000 80" preserveAspectRatio="none" aria-hidden="true">
        <path class="dk-pipeline__wire-base" d="M60 40 H 940" />
        <path class="dk-pipeline__wire-flow" d="M60 40 H 940" />
      </svg>
      <ol class="dk-pipeline__nodes" role="list">
        {pipeline.map((step) => (
          <li class={`dk-node dk-node--${step.tone}`} tabindex="0">
            <span class="dk-node__code">{step.code}</span>
            <span class="dk-node__pulse" aria-hidden="true"></span>
            <h3>{step.label}</h3>
            <p>{step.body}</p>
            <span class="dk-node__pill">{step.status}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══════════════════════ FEATURES (MANIFEST) ════════════════ -->
  <section class="content-band" id="features" aria-labelledby="features-title">
    <div class="section-heading">
      <p class="eyebrow">What's on the deck</p>
      <h2 id="features-title">The five things desks ask for first.</h2>
      <p>Modular and à la carte — turn on what you need today, enable the rest in a couple of clicks as operations grow.</p>
    </div>

    <div class="dk-manifest">
      {manifest.map((item) => (
        <article class="dk-manifest__row">
          <span class="dk-manifest__index">{item.index}</span>
          <div class="dk-manifest__body">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Margin simulator -->
    <div class="dk-sim" id="margin-sim">
      <div class="dk-sim__copy">
        <p class="eyebrow">Live · try it</p>
        <h3>Price it like the desk does.</h3>
        <p>
          Index, differential, premiums — the same formula the platform locks onto the
          confirmation. Drag the sliders; watch the margin move.
        </p>
      </div>
      <div class="dk-sim__panel" aria-label="Margin simulator">
        <div class="dk-sim__row">
          <label for="sim-index">Index (VLSFO 0.5%)</label>
          <span class="dk-sim__out" id="sim-index-out">$573.50</span>
          <input type="range" id="sim-index" min="400" max="750" step="0.5" value="573.5" />
        </div>
        <div class="dk-sim__row">
          <label for="sim-diff">Differential</label>
          <span class="dk-sim__out" id="sim-diff-out">+$12.00</span>
          <input type="range" id="sim-diff" min="-40" max="40" step="0.5" value="12" />
        </div>
        <div class="dk-sim__row">
          <label for="sim-premium">Premiums &amp; fees</label>
          <span class="dk-sim__out" id="sim-premium-out">$28.00</span>
          <input type="range" id="sim-premium" min="0" max="80" step="0.5" value="28" />
        </div>
        <div class="dk-sim__result">
          <div><span class="dk-sim__result-label">Client price / mt</span><span class="dk-sim__result-value" id="sim-price">$613.50</span></div>
          <div><span class="dk-sim__result-label">Your cost / mt</span><span class="dk-sim__result-value" id="sim-cost">$566.20</span></div>
          <div class="dk-sim__margin">
            <span class="dk-sim__result-label">Margin</span>
            <span class="dk-sim__result-value dk-amber" id="sim-margin">$47.30 / mt</span>
          </div>
        </div>
      </div>
    </div>

    <details class="dk-also">
      <summary>Also in the box <span>— 12 more modules</span></summary>
      <ul role="list">
        {alsoInBox.map((item) => <li>{item}</li>)}
      </ul>
    </details>
  </section>

  <!-- ═══════════════════════════ INTEGRATIONS ═══════════════════ -->
  <section class="content-band content-band--contrast" id="integrations" aria-labelledby="integrations-title">
    <div class="section-heading">
      <p class="eyebrow">Integrations</p>
      <h2 id="integrations-title">Plugged into the tools your teams already live in.</h2>
      <p>Identity, communication, market data, accounting, and AI — connected out of the box, inside your deployment boundary.</p>
    </div>

    <div class="dk-featured dk-featured--llm">
      <div class="dk-featured__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v3"/><path d="M12 19v3"/><path d="M4.2 4.2l2.1 2.1"/><path d="M17.7 17.7l2.1 2.1"/><path d="M2 12h3"/><path d="M19 12h3"/><circle cx="12" cy="12" r="5"/></svg>
      </div>
      <div>
        <h3>Built-in private LLM</h3>
        <p>
          An in-tenant assistant for drafting emails, summarising threads, extracting data from
          PDFs, and answering deal questions. <strong class="dk-amber">Your data never leaves the deployment</strong> —
          it never touches a shared model.
        </p>
      </div>
      <span class="dk-featured__pill">In-tenant</span>
    </div>

    <div class="dk-marquee" aria-hidden="true">
      <div class="dk-marquee__track dk-marquee__track--left">
        {[...marqueeA, ...marqueeA].map((name) => <span class="dk-marquee__chip">{name}</span>)}
      </div>
      <div class="dk-marquee__track dk-marquee__track--right">
        {[...marqueeB, ...marqueeB].map((name) => <span class="dk-marquee__chip">{name}</span>)}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ ⌘K PALETTE ═════════════════════ -->
  <section class="content-band" id="palette" aria-labelledby="palette-title">
    <div class="section-heading narrow">
      <p class="eyebrow">One keystroke</p>
      <h2 id="palette-title">The desk is a command line.</h2>
      <p>Every deal, vessel, company, and port — reachable from anywhere in the app with ⌘K. No menu spelunking, no saved searches.</p>
    </div>
    <div class="dk-palette" role="img" aria-label="Preview of the Fueld command palette searching for credit holds in Rotterdam">
      <div class="dk-palette__panel">
        <div class="dk-palette__input">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
          <span class="dk-palette__query">credit hold <span class="dk-amber">rotterdam</span></span>
          <span class="dk-palette__caret" aria-hidden="true"></span>
          <span class="dk-palette__esc">esc</span>
        </div>
        <ul class="dk-palette__results" role="list">
          <li class="dk-palette__hit dk-palette__hit--active">
            <span class="dk-palette__glyph">◍</span>
            <div><strong>Vessel credit check — Rotterdam</strong><span>2 stems · exposure $860K of $1.2M limit</span></div>
            <kbd>↵</kbd>
          </li>
          <li class="dk-palette__hit">
            <span class="dk-palette__glyph">▤</span>
            <div><strong>Orders on credit hold</strong><span>3 open · oldest 2 days</span></div>
          </li>
          <li class="dk-palette__hit">
            <span class="dk-palette__glyph">⚓</span>
            <div><strong>Rotterdam — bunkering ports</strong><span>42 suppliers · 6 grades</span></div>
          </li>
        </ul>
        <div class="dk-palette__foot">
          <span><kbd>↑↓</kbd> navigate</span>
          <span><kbd>↵</kbd> open</span>
          <span><kbd>⌘K</kbd> anywhere</span>
        </div>
      </div>
    </div>
  </section>


---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { siteConfig } from '../config/site';

const roles = [
  {
    name: 'Broker',
    body:
      'Move from RFQ to confirmation without re-typing. Capture inquiries, compare quotes, and track negotiations in one thread. Client history and margin always in view.',
    icon: 'broker',
  },
  {
    name: 'Trader',
    body:
      'Find suppliers anywhere in the world in seconds, execute with live market context, enforce credit at confirmation, and watch positions and margin update in real time — with an audit-ready trail.',
    icon: 'trader',
  },
  {
    name: 'Physical Supplier',
    body:
      'Plan barges, trucks, and slots against live inventory. Match stock to liftings, capture quotes through the supplier portal, and keep dispatch, BDN, and reconciliation in one place from nomination to sign-off.',
    icon: 'supplier',
  },
];

const features = [
  { title: 'Inquiry & RFQ', body: 'Create RFQs, compare quotes, and track results end-to-end inside one operating thread.', icon: 'rfq' },
  { title: 'Global supplier directory', body: 'Searchable counterparty network covering ports worldwide — find suppliers by port, product, grade, and historical performance in seconds.', icon: 'globe' },
  { title: 'Supplier portal', body: 'Suppliers submit quotes, confirmations, and BDNs through a secure self-service portal — no email ping-pong, no re-keying on your side.', icon: 'portal' },
  { title: 'Supplier inquiry intelligence', body: 'Score, rank, and predict supplier responsiveness, win rate, and pricing behaviour from your own historical inquiry data.', icon: 'intel' },
  { title: 'Approach system', body: 'Structured outreach playbooks for new counterparties — sequenced touches, ownership, and follow-ups, all on the deal record.', icon: 'approach' },
  { title: 'Inventory & stock', body: 'Track product, grade, density, and volume across tanks, barges, trucks, and terminals — reconciled to liftings and dips, ready for stem planning.', icon: 'inventory' },
  { title: 'Pricing engine & margin builder', body: 'Build prices from index + differential + premiums, simulate margin live, and lock the formula onto the confirmation.', icon: 'pricing' },
  { title: 'Transactions', body: 'Confirmations, reconciliation, and audits with real-time status controls and a clean trail.', icon: 'tx' },
  { title: 'Documents & versioning', body: 'Generate confirmations, nominations, BDNs, and invoices — every revision tracked, diffed, and linked to who changed what and when.', icon: 'doc' },
  { title: 'Credit Management', body: 'Limits, exposure, holds and releases, and approval routing close to the trade.', icon: 'credit' },
  { title: 'Risk & Compliance', body: 'Counterparty screening, policy checks, and evidence captured where it actually happens.', icon: 'shield' },
  { title: 'Configurable, no consultants', body: 'Workflows, fields, document templates, approval rules, and pricing logic — all configurable in-app by your own admins. No consultancy hours required.', icon: 'config' },
];

const integrations = [
  {
    name: 'Microsoft 365 SSO',
    body: 'Sign in with Entra ID / Azure AD. Enforce conditional access and group-based permissions across the platform.',
    icon: 'microsoft',
    status: 'Available',
  },
  {
    name: 'Outlook & Exchange',
    body: 'Send confirmations, nominations, and BDNs from your corporate Outlook identity. Replies thread back onto the deal.',
    icon: 'outlook',
    status: 'Available',
  },
  {
    name: 'Passkeys & 2FA',
    body: 'Phishing-resistant WebAuthn passkeys plus TOTP fallback. No more shared passwords, no SMS exposure.',
    icon: 'passkey',
    status: 'Available',
  },
  {
    name: 'WhatsApp for Business',
    body: 'Confirm liftings, share nominations, and notify counterparties on the channel they actually answer on.',
    icon: 'whatsapp',
    status: 'Available',
  },
  {
    name: 'Live AIS vessel data',
    body: 'Track vessel position, ETA, and port calls in real time alongside the inquiry, nomination, or delivery.',
    icon: 'ais',
    status: 'Available',
  },
  {
    name: 'QuickBooks & accounting',
    body: 'Push invoices, credit notes, and reconciled deliveries into QuickBooks Online — extendable to Xero, SAP, or NetSuite.',
    icon: 'quickbooks',
    status: 'Available',
  },
  {
    name: 'Built-in private LLM',
    body: 'In-tenant assistant for drafting emails, summarising threads, extracting data from PDFs, and answering deal questions — your data never leaves the deployment.',
    icon: 'llm',
    status: 'Available',
  },
  {
    name: 'Push notifications',
    body: 'Native iOS, Android, and desktop push for new RFQs, credit holds, nomination changes, and delivery sign-offs.',
    icon: 'bell',
    status: 'Available',
  },
  {
    name: 'Platts & price feeds',
    body: 'Ingest Platts, Argus, and broker indications directly into pricing logic and quote comparisons.',
    icon: 'feed',
    status: 'Available',
  },
];

const tradingDeepDive = {
  trader: [
    { title: 'Position & exposure', body: 'Long/short by product, port, and counterparty in real time.' },
    { title: 'Hedging & paper trades', body: 'Link swaps and futures to physical positions in one P&L view.' },
    { title: 'Multi-currency & FX', body: 'Quote, invoice, and settle in any currency with live FX rates.' },
    { title: 'Vessel & fleet database', body: 'IMO-keyed ownership, class, and manager history at your fingertips.' },
    { title: 'Demurrage, claims & disputes', body: 'Track evidence and resolve disputes without leaving the deal.' },
  ],
  supplier: [
    { title: 'Barge & truck dispatch', body: 'Slots, stems, drivers, and availability in one drag-and-drop board.' },
    { title: 'Quality & sampling (COQ)', body: 'Density correction, MARPOL samples, and lab links per delivery.' },
    { title: 'Sub-contractor barges', body: 'Broker the slot and manage the margin when you don\u2019t own the barge.' },
    { title: 'Dipping & loss control', body: 'Open/close dips and BDN vs system reconciliation, automated.' },
    { title: 'Multi-port operations', body: 'One operating view across every terminal, port, and depot you run.' },
  ],
};

const proofStats = [
  { label: 'Median API response', value: '< 200 ms' },
  { label: 'Uptime SLO on managed', value: '99.9%' },
  { label: 'Self-host installer', value: '1 day' },
  { label: 'Modules to switch on', value: 'à la carte' },
];

const roadmap = [
  {
    title: 'Voice-to-deal capture',
    body: 'Dictate an inquiry from the bridge or the truck and have it parsed into a structured RFQ automatically.',
  },
  {
    title: 'EU ETS & FuelEU compliance pack',
    body: 'Emissions, allowances, and compliance evidence captured per delivery, with reporting exports built in.',
  },
  {
    title: 'Continuous counterparty risk scoring',
    body: 'KYC, sanctions, and credit signals continuously blended into a single score on the deal screen.',
  },
  {
    title: 'Salesforce & HubSpot CRM sync',
    body: 'Two-way sync of accounts, contacts, and pipeline so commercial teams keep working in their CRM of choice.',
  },
  {
    title: 'Teams & Slack channels',
    body: 'Push deal events into Microsoft Teams or Slack rooms, and act on them with inline buttons.',
  },
  {
    title: 'Mobile field app for crews',
    body: 'Native iOS/Android app for barge masters, drivers, and surveyors \u2014 captures dips, photos, and signatures offline.',
  },
];

const sovereigntyPoints = [
  'Dedicated deployment, not a pooled SaaS tenant database.',
  'Self-hosted, on-premises, or dedicated managed infrastructure.',
  'Regional hosting aligned to your internal policy and customer expectations.',
  'No shared training or feedback loop across customer data. License validation only.',
  'You remain the data controller. Fueld acts as processor only when explicitly engaged.',
  'GDPR, UK GDPR, and equivalent regional regimes addressed by design — not retrofitted.',
];

const compliance = [
  {
    title: 'GDPR & UK GDPR',
    body: 'Lawful basis, data subject rights (access, rectification, erasure, portability), and 72-hour breach notification baked into the operating model.',
  },
  {
    title: 'Data Processing Agreement',
    body: 'Standard DPA with EU SCCs and UK IDTA addendum available. Sub-processor list is short, transparent, and pinned to your deployment.',
  },
  {
    title: 'Data residency',
    body: 'EU, UK, US, UAE, Singapore — pick the region. Data, backups, and logs stay inside the boundary you choose.',
  },
  {
    title: 'Retention & deletion',
    body: 'Configurable retention windows per record type. Verified erasure on request, with cryptographic shredding on encrypted backups.',
  },
  {
    title: 'Access boundary',
    body: 'No Fueld operator access to your data by default. Break-glass access is opt-in, time-boxed, logged, and customer-approved.',
  },
  {
    title: 'Audit & evidence',
    body: 'Append-only audit log of every read, write, send, and approval. Exportable for SOC 2, ISO 27001, and internal review.',
  },
];

const faqs = [
  {
    question: 'How fast can we be live?',
    answer:
      'Self-hosted deployments install in roughly a day with the provided installer. A typical managed go-live with data migration, SSO, document templates, and team training runs four to eight weeks depending on scope.',
  },
  {
    question: 'How is Fueld priced?',
    answer:
      'Annual license per active user with a deployment fee. Modules are à la carte — only pay for what you turn on. Self-hosted, managed, and on-prem all use the same license; only the operational support model changes. Concrete numbers shared on the demo call.',
  },
  {
    question: 'Is this a shared multi-tenant SaaS platform?',
    answer:
      'No. The commercial model we are presenting here is dedicated deployment. Your environment and your data are not mixed into a shared customer pool.',
  },
  {
    question: 'Can we host Fueld in our own environment?',
    answer:
      'Yes. The intended operating model includes self-hosted and on-premises deployment, alongside a dedicated managed option if you want operational support.',
  },
  {
    question: 'Do you support teams working from mobile devices?',
    answer:
      'Yes. The product is designed for responsive usage across phones, tablets, and desktop workflows, especially when teams need to follow activity away from the desk.',
  },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.siteUrl,
    email: siteConfig.contactEmail,
    description: siteConfig.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Fueld',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description:
      'Dedicated bunker trading software with data sovereignty, regional hosting control, and mobile-ready workflows.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      description: 'Commercial pricing is provided during a sales conversation.',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title="Bunker trading & physical supply software"
  description="One platform for bunker brokers, traders, and physical maritime suppliers. RFQ to barge dispatch to BDN, with passkeys, Microsoft 365 SSO, Outlook, WhatsApp, live AIS, QuickBooks, and a built-in private LLM. Dedicated deployment, never a shared SaaS pool."
  path="/"
  schemas={schemas}
>
  <section class="hero-band">
    <div class="hero-copy">
      <p class="eyebrow">For brokers, traders &amp; physical maritime suppliers</p>
      <h1>One platform. Trading desk and physical supply, end to end.</h1>
      <p class="hero-lead">
        Fueld runs the commercial, finance, and operational stack for bunker brokers,
        traders, and physical suppliers — from RFQ to barge dispatch to BDN — on
        infrastructure you control. Not a shared SaaS pool.
      </p>
      <div class="cta-row">
        <a class="button button-primary" href="#contact">Book a demo →</a>
        <a class="button button-secondary" href="#features">See features</a>
      </div>
      <dl class="trust-strip" aria-label="Key differentiators">
        <div>
          <dt>Deployment</dt>
          <dd>Dedicated · self-hosted · managed</dd>
        </div>
        <div>
          <dt>Hosting region</dt>
          <dd>Your jurisdiction, your choice</dd>
        </div>
        <div>
          <dt>Data boundary</dt>
          <dd>No shared customer data loop</dd>
        </div>
      </dl>
    </div>

    <div class="hero-stage" aria-hidden="true">
      <div class="mock-window">
        <div class="mock-window__bar">
          <span></span><span></span><span></span>
          <span class="mock-window__url">app.fueld / inquiries</span>
        </div>
        <div class="mock-window__body">
          <div class="mock-row">
            <span class="mock-row__dot"></span>
            <div>
              <span class="mock-row__label">Rotterdam — VLSFO 0.5%</span>
              <span class="mock-row__sub">3 quotes · margin $4.20/mt</span>
            </div>
            <span class="mock-row__pill">Confirmed</span>
          </div>
          <div class="mock-row">
            <span class="mock-row__dot mock-row__dot--amber"></span>
            <div>
              <span class="mock-row__label">Singapore — MGO</span>
              <span class="mock-row__sub">Awaiting credit approval</span>
            </div>
            <span class="mock-row__pill mock-row__pill--amber">Pending</span>
          </div>
          <div class="mock-row">
            <span class="mock-row__dot mock-row__dot--cyan"></span>
            <div>
              <span class="mock-row__label">Fujairah — VLSFO</span>
              <span class="mock-row__sub">BDN generated · sent to vessel</span>
            </div>
            <span class="mock-row__pill">Delivered</span>
          </div>
          <div class="mock-floating">
            <div class="mock-stat">
              <p class="mock-stat__label">Live exposure</p>
              <p class="mock-stat__value">$2.4M</p>
              <span class="mock-stat__delta">▲ 12% wk</span>
            </div>
            <div class="mock-stat">
              <p class="mock-stat__label">Open inquiries</p>
              <p class="mock-stat__value">38</p>
              <span class="mock-stat__delta">▲ 6 today</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-band" id="roles" aria-labelledby="roles-title">
    <div class="section-heading">
      <p class="eyebrow">Roles</p>
      <h2 id="roles-title">Trading desk and physical supply, in one product.</h2>
      <p>
        Purpose-built for the marine fuel chain — brokers, traders, and physical suppliers operating
        barges, trucks, and terminals. Same product, role-aware workflows, no bolt-on ERP.
      </p>
    </div>
    <div class="role-grid">
      {roles.map((role) => (
        <article class="role-card">
          <div class="role-card__icon" aria-hidden="true">
            {role.icon === 'broker' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg>
            )}
            {role.icon === 'trader' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg>
            )}
            {role.icon === 'supplier' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16h18l-2 4H5z"/><path d="M5 16V9l4-3h6l4 3v7"/><path d="M9 13h6"/></svg>
            )}
          </div>
          <h3>{role.name}</h3>
          <p>{role.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="content-band" id="features" aria-labelledby="features-title">
    <div class="section-heading">
      <p class="eyebrow">Features</p>
      <h2 id="features-title">Everything you need, at your fingertips.</h2>
      <p>
        Modular and flexible. Turn on the modules you need today and enable the rest in a couple
        of clicks as operations grow.
      </p>
    </div>
    <div class="feature-grid">
      {features.map((feature) => (
        <article class="feature-card">
          <div class="feature-card__icon" aria-hidden="true">
            {feature.icon === 'rfq' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>}
            {feature.icon === 'globe' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18"/><path d="M12 3a14 14 0 0 0 0 18"/></svg>}
            {feature.icon === 'portal' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/><circle cx="6" cy="6" r="0.6" fill="currentColor"/></svg>}
            {feature.icon === 'intel' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l3-3 3 2 5-6"/><circle cx="18" cy="8" r="1.4"/></svg>}
            {feature.icon === 'approach' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8 8l8 8"/><path d="M14 6h4v4"/></svg>}
            {feature.icon === 'inventory' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="1"/><path d="M3 12h18"/><path d="M8 7V4h8v3"/><path d="M8 16h3"/></svg>}
            {feature.icon === 'pricing' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 6H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6"/></svg>}
            {feature.icon === 'tx' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>}
            {feature.icon === 'doc' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h6"/><path d="M8 17h4"/></svg>}
            {feature.icon === 'credit' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>}
            {feature.icon === 'shield' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
            {feature.icon === 'config' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>}
            {feature.icon === 'chart' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 4 4 5-7"/></svg>}
          </div>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="content-band content-band--thin" aria-label="Platform proof points">
    <ul class="proof-strip" role="list">
      {proofStats.map((stat) => (
        <li class="proof-strip__item">
          <span class="proof-strip__value">{stat.value}</span>
          <span class="proof-strip__label">{stat.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="content-band" id="deep-dive" aria-labelledby="deep-dive-title">
    <div class="section-heading">
      <p class="eyebrow">Built for the way you operate</p>
      <h2 id="deep-dive-title">The specifics traders and physical suppliers actually ask about.</h2>
      <p>
        Two operating models, one platform. Each side gets the depth it needs without dragging the other team
        through a screen they will never use.
      </p>
    </div>
    <div class="deep-dive-grid">
      <article class="deep-dive-col">
        <header class="deep-dive-col__head">
          <span class="deep-dive-col__tag">Trader</span>
          <h3>Market-facing depth</h3>
        </header>
        <ul role="list">
          {tradingDeepDive.trader.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <span>{item.body}</span>
            </li>
          ))}
        </ul>
      </article>
      <article class="deep-dive-col">
        <header class="deep-dive-col__head">
          <span class="deep-dive-col__tag deep-dive-col__tag--alt">Physical supplier</span>
          <h3>Operational depth</h3>
        </header>
        <ul role="list">
          {tradingDeepDive.supplier.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <span>{item.body}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="content-band" id="platform" aria-labelledby="platform-title">
    <div class="section-heading">
      <p class="eyebrow">Platform</p>
      <h2 id="platform-title">Enterprise-grade — performance, reliability, security.</h2>
      <p>The same engineering bar as the systems you depend on. Built for the way bunker teams actually work.</p>
    </div>
    <div class="platform-grid">
      <article class="platform-card">
        <h3>Responsive design</h3>
        <p>Works beautifully on mobile, tablet, and desktop, so work keeps moving away from the desk.</p>
        <div class="platform-card__visual">
          <div class="phone-mock" aria-hidden="true">
            <div class="phone-mock__inner">
              <div class="phone-mock__time">9:41</div>
              <div class="phone-mock__row"><strong>RTM VLSFO</strong>3 quotes · $4.20/mt</div>
              <div class="phone-mock__row"><strong>SIN MGO</strong>Credit pending</div>
              <div class="phone-mock__row"><strong>FUJ VLSFO</strong>BDN sent</div>
            </div>
          </div>
        </div>
      </article>

      <article class="platform-card">
        <h3>Performance</h3>
        <p>Engineered for millisecond speed end-to-end, so everything just feels instant.</p>
        <div class="platform-card__visual">
          <div class="perf-bar" aria-hidden="true">
            <span class="perf-bar__method">GET</span>
            <span>/api/orders</span>
            <span class="perf-bar__time">192 ms</span>
          </div>
          <div class="perf-meter" aria-hidden="true"><span class="perf-meter__fill"></span></div>
        </div>
      </article>

      <article class="platform-card">
        <h3>Security</h3>

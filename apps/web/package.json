{
  "name": "@fueld/web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "sh scripts/serve.sh",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "rm -rf coverage/e2e && PW_COVERAGE=1 playwright test && node ./e2e/coverage-summary.mjs",
    "pw:install": "playwright install --with-deps"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "bun@1.3.8",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/service-worker": "^21.1.0",
    "@fueld/types": "workspace:*",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/postcss": "^4.3.1",
    "echarts": "^6.1.0",
    "leaflet": "^1.9.4",
    "ngx-echarts": "^21.0.0",
    "pdfjs-dist": "^5.5.207",
    "postcss": "^8.5.15",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "@playwright/test": "^1.61.0",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "@types/node": "^22.13.5",
    "@types/leaflet": "^1.9.21",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "4.1.9"
  }
}
# ═══════════════════════════════════════════════════════════════
#  Fueld Production Environment — Template
#  Copy to your app directory as .env (default: /opt/fueld/.env)
# ═══════════════════════════════════════════════════════════════

# Database
DATABASE_URL=postgres://fueld:CHANGE_ME@localhost:5432/fueld

# JWT (MUST be persistent across deploys for session continuity)
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_64_CHARS

# Encryption for stored third-party credentials (MUST stay persistent across deploys/restores)
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_HEX_CHARS

# Application
PORT=3000
CORS_ORIGIN=https://your-domain.example.com
APP_URL=https://your-domain.example.com

# WebAuthn / Passkeys
WEBAUTHN_RP_NAME=Fueld
WEBAUTHN_RP_ID=your-domain.example.com
WEBAUTHN_ORIGIN=https://your-domain.example.com

# Drizzle migrations
MIGRATIONS_DIR=/opt/fueld/drizzle

# GeoIP data directory (geoip-lite)
GEODATADIR=/opt/fueld/geoip-data

# Admin seed password (auto-generated by setup-vps.sh)
ADMIN_PASSWORD=CHANGE_ME_OR_RUN_SETUP_SCRIPT

# SMTP (invite emails)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=YOUR_BREVO_LOGIN
SMTP_PASS=YOUR_BREVO_SMTP_KEY
SMTP_FROM=noreply@fueld.app
SMTP_SECURE=false


# Lloyd's List Intelligence (optional)
# LLI_USERNAME=
# LLI_PASSWORD=

# QuickBooks (optional)
# QB_CLIENT_ID=
# QB_CLIENT_SECRET=
# QB_REDIRECT_URI=https://your-domain.example.com/api/quickbooks/callback
# QB_ENVIRONMENT=production

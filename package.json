{
  "name": "fueld",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --filter @fueld/api dev",
    "dev:web": "bun run --filter @fueld/web start",
    "dev:marketing": "bun run --filter @fueld/marketing dev",
    "build:api": "bun run --filter @fueld/api build",
    "build:web": "bun run --filter @fueld/web build",
    "build:marketing": "bun run --filter @fueld/marketing build",
    "build:meta": "bun run scripts/release/generate-build-meta.ts",
    "check:marketing": "bun run --filter @fueld/marketing check",
    "dev": "bun run dev:api & bun run dev:web",
    "typecheck": "cd apps/api && bun run typecheck && cd ../web && bunx tsc --noEmit -p tsconfig.json && cd ../marketing && bun run check",
    "preview:marketing": "bun run --filter @fueld/marketing preview",
    "ship": "bun run typecheck && git add -A && git commit && git push",
    "test": "bun run --filter @fueld/api test && bun test packages/types/tests",
    "test:raw": "bun test apps/api/tests packages/types/tests",
    "test:coverage": "bun run --filter @fueld/api test:coverage && bun test --coverage packages/types/tests",
    "test:orders": "bun test apps/api/tests/orders*.test.ts apps/api/tests/orders*.e2e.test.ts",
    "test:orders:coverage": "bun test --coverage apps/api/tests/orders*.test.ts apps/api/tests/orders*.e2e.test.ts",
    "otp:manual": "bun run scripts/otp/manual-otp.ts",
    "llm:setup": "bash scripts/llm/setup.sh",
    "llm:start": "bash scripts/llm/start.sh"
  },
  "devDependencies": {
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.0"
  },
  "dependencies": {
    "@plannotator/pi-extension": "^0.22.0",
    "@ryan_nookpi/pi-extension-diff-review": "^0.2.7",
    "@tmustier/pi-files-widget": "^0.2.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "pi-claude-auth": "^0.1.3",
    "pi-cmux": "^0.1.16",
    "pi-keyrouter": "^0.4.0",
    "pi-memory": "^0.3.14",
    "pi-search-hub": "^2.8.0",
    "pi-subagents": "^0.34.0",
    "pi-vision-tool": "^1.3.7",
    "version": "^0.1.2",
    "view": "^1.1.1"
  }
}

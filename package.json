{
  "name": "fueld",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --filter @fueld/api dev",
    "dev:web": "bun run --filter @fueld/web start",
    "build:api": "bun run --filter @fueld/api build",
    "build:web": "bun run --filter @fueld/web build",
    "build:meta": "bun run scripts/release/generate-build-meta.ts",
    "dev": "bun run dev:api & bun run dev:web",
    "test": "bun run --filter @fueld/api test && bun test packages/types/tests",
    "test:raw": "bun test apps/api/tests packages/types/tests",
    "test:coverage": "bun run --filter @fueld/api test:coverage && bun test --coverage packages/types/tests",
    "test:orders": "bun test apps/api/tests/orders*.test.ts apps/api/tests/orders*.e2e.test.ts",
    "test:orders:coverage": "bun test --coverage apps/api/tests/orders*.test.ts apps/api/tests/orders*.e2e.test.ts",
    "llm:setup": "bash scripts/llm/setup.sh",
    "llm:start": "bash scripts/llm/start.sh"
  },
  "devDependencies": {
    "pdf-parse": "^2.4.5"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9"
  }
}
